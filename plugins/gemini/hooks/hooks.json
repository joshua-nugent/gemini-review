{
  "description": "Notify the user when Claude auto-invokes the gemini-consultant subagent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/consult-banner.mjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
